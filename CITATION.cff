url: "https://earthlab.github.io/spectralbridge/"
license: GPL-3.0-or-later
keywords:
  - "NEON"
  - "hyperspectral"
  - "remote sensing"
  - "scientific infrastructure"
  - "cross-sensor calibration"
authors:
