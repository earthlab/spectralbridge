       "5   /iplant/home/shared/earthlab/macrosystems/Aug_...           1   \n",
       "6   /iplant/home/shared/earthlab/macrosystems/Aug_...           2   \n",
       "7   /iplant/home/shared/earthlab/macrosystems/Aug_...           2   \n",
       "8   /iplant/home/shared/earthlab/macrosystems/Aug_...           2   \n",
       "9   /iplant/home/shared/earthlab/macrosystems/Aug_...           2   \n",
       "10  /iplant/home/shared/earthlab/macrosystems/Aug_...           1   \n",
