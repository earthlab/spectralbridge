   "source": [
    "## 7. TRANSFER stage"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 24,
   "id": "7e21af95",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "[1/168] YELL_full_1/NEON_D12_YELL_DP1_L025-1_20230719_directional_reflectance/NEON_D12_YELL_DP1_L025-1_20230719_directional_reflectance_landsat_tm_envi.hdr\n",
      "[26/168] YELL_full_2/NEON_D12_YELL_DP1_L040-1_20230715_directional_reflectance/NEON_D12_YELL_DP1_L040-1_20230715_directional_reflectance_landsat_tm_envi.img\n",
      "[51/168] NIWO_full_1/NEON_D13_NIWO_DP1_20200801_162711_reflectance/NEON_D13_NIWO_DP1_20200801_162711_reflectance_landsat_etm+_envi.hdr\n",
      "[76/168] NIWO_full_2/NEON_D13_NIWO_DP1_20200807_161351_reflectance/NEON_D13_NIWO_DP1_20200807_161351_reflectance_landsat_tm_envi.img\n",
      "[101/168] Full_01/NEON_D13_NIWO_DP1_20200807_162134_reflectance/NEON_D13_NIWO_DP1_20200807_162134_reflectance_landsat_etm+_envi.hdr\n",
      "[126/168] WREF_full_1/NEON_D16_WREF_DP1_L030-1_20230624_directional_reflectance/NEON_D16_WREF_DP1_L030-1_20230624_directional_reflectance_landsat_oli_envi.img\n",
      "[151/168] WREF_full_2/NEON_D16_WREF_DP1_L050-1_20230624_directional_reflectance/NEON_D16_WREF_DP1_L050-1_20230624_directional_reflectance_landsat_oli2_envi.hdr\n",
      "✓ TRANSFER APPROVED.\n",
