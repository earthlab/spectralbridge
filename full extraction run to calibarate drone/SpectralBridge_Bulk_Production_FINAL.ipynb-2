      "\n",
      "✓ API DISCOVERY APPROVED.\n",
      "run_bulk_pipeline: spectralbridge\n",
      "DEFAULT_PRODUCT_REGISTRY: spectralbridge.bulk.analyses.common\n",
      "summary_supported: True\n",
      "Next: planning will run automatically in RUN_STAGE='all' mode.\n"
     ]
