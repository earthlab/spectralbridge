       "0    accepted_population_matches_preflight    True\n",
       "1        duplicate_count_matches_preflight    True\n",
       "2  rejected_source_count_matches_preflight    True\n",
       "3      selected_pair_names_match_preflight    True\n",
       "4           translation_pairs_are_nonempty    True\n",
       "5                regressions_were_executed    True\n",
