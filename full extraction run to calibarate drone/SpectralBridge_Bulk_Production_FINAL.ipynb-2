      "      \"symbol\": \"DEFAULT_PRODUCT_REGISTRY\"\n",
      "    },\n",
      "    {\n",
      "      \"module\": \"spectralbridge.bulk.flightline_outputs\",\n",
      "      \"symbol\": \"DEFAULT_PRODUCT_REGISTRY\"\n",
      "    },\n",
      "    {\n",
      "      \"module\": \"spectralbridge.bulk.registry\",\n",
      "      \"symbol\": \"DEFAULT_PRODUCT_REGISTRY\"\n",
      "    },\n",
      "    {\n",
      "      \"module\": \"spectralbridge.drone_translation\",\n",
      "      \"symbol\": \"DEFAULT_PRODUCT_REGISTRY\"\n",
      "    },\n",
      "    {\n",
      "      \"module\": \"spectralbridge.drone_translation_registry\",\n",
      "      \"symbol\": \"DEFAULT_PRODUCT_REGISTRY\"\n",
      "    },\n",
      "    {\n",
      "      \"module\": \"spectralbridge.pipelines.bulk\",\n",
      "      \"symbol\": \"DEFAULT_PRODUCT_REGISTRY\"\n",
      "    }\n",
      "  ],\n",
      "  \"summarize_bulk_results\": [\n",
