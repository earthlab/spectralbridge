include README.md
include LICENSE
include CITATION.cff
include pyproject.toml
include pytest.ini
include mkdocs.yml
include requirements-dev.txt
include environment.yaml

recursive-include src/spectralbridge/data *.json
recursive-include docs *.md *.png *.jpg *.jpeg *.svg *.css *.js *.yml *.yaml
recursive-include tests *.py

recursive-exclude docs/_build *
prune data
prune deprecated
prune site
prune .github
prune Datasets
prune vendor

global-exclude __pycache__ *.py[cod]

exclude gocmd
exclude move_folders_from_instance_to_remote.py
exclude remote_to_instance.py
exclude patch_script_toworkfromcorrectedfiles.py
exclude PROMPT_LOG.md
exclude Drone_processing.ipynb
exclude Raster_processing.ipynb
exclude :memory:
exclude ty_tuff_contributions_last_year.md
