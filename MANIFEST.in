include README.md
include LICENSE
include NOTICE
include HYTOOLS_PROVENANCE.md
include CITATION.cff
include pyproject.toml
include pytest.ini
include mkdocs.yml
include requirements-dev.txt
include environment.yaml
prune provenance
include provenance/hytools.json

recursive-include src/spectralbridge/data *.json
recursive-include docs *.md *.png *.jpg *.jpeg *.svg *.css *.js *.yml *.yaml
recursive-include examples *.py *.json
recursive-include tests *.py

recursive-exclude docs/_build *
prune data
prune deprecated
prune site
prune .github
prune Datasets
prune vendor

global-exclude __pycache__ *.py[cod]

exclude gocmd
exclude move_folders_from_instance_to_remote.py
exclude remote_to_instance.py
exclude patch_script_toworkfromcorrectedfiles.py
exclude PROMPT_LOG.md
exclude Drone_processing.ipynb
exclude Raster_processing.ipynb
exclude :memory:
exclude ty_tuff_contributions_last_year.md

# Research/publication snapshots are repository evidence, not installed inputs.
prune archive
prune paper
prune drafts

# Historical machine-specific investigation narratives remain in the repository,
# not in installation artifacts. Their underlying provenance is already pruned.
exclude docs/dev/drone-spatial-integrity-investigation.md
exclude docs/dev/publication-hardening-audit-2026-09-04.md
